{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originrouter.com/schemas/compatibility-code-bundle-v1.json",
  "title": "OriginRouter Compatibility Code Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "revision", "complete_snapshot", "patches"],
  "properties": {
    "schema": {"const": "originrouter-compatibility-code-bundle-v1"},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "integer", "minimum": 1},
    "min_engine_version": {"type": ["string", "null"]},
    "max_engine_version": {"type": ["string", "null"]},
    "generated_at": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"]},
    "complete_snapshot": {"const": true},
    "patches": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "phase", "module"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "name": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
          "version": {"type": "string", "minLength": 1, "maxLength": 32},
          "phase": {"enum": ["request", "response", "stream", "error"]},
          "priority": {"type": "integer", "minimum": -100000, "maximum": 100000},
          "required": {"type": "boolean"},
          "failure_mode": {"enum": ["reject", "passthrough"]},
          "match": {"type": "object"},
          "before": {"type": "array", "items": {"type": "string"}},
          "after": {"type": "array", "items": {"type": "string"}},
          "conflicts_with": {"type": "array", "items": {"type": "string"}},
          "module": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtime", "abi", "sha256", "bytes"],
            "properties": {
              "runtime": {"const": "wasm"},
              "abi": {"const": "originrouter-json-dom-v1"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bytes": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
