{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originrouter.com/schemas/model-compatibility-pack-v1.json",
  "title": "OriginRouter Model Compatibility Patch Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_id", "revision", "patches"],
  "properties": {
    "schema": { "const": "originrouter-model-compatibility-pack-v1" },
    "pack_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "integer", "minimum": 1 },
    "channel": { "enum": ["stable", "beta", "canary"], "default": "stable" },
    "min_engine_version": { "type": ["string", "null"], "maxLength": 32 },
    "max_engine_version": { "type": ["string", "null"], "maxLength": 32 },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "patches": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/patch" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "methods": { "$ref": "#/$defs/stringList" },
        "paths": { "$ref": "#/$defs/stringList" },
        "protocols": { "$ref": "#/$defs/stringList" },
        "runtimes": { "$ref": "#/$defs/stringList" },
        "providers": { "$ref": "#/$defs/stringList" },
        "provider_families": { "$ref": "#/$defs/stringList" },
        "exclude_provider_families": { "$ref": "#/$defs/stringList" },
        "models": { "$ref": "#/$defs/stringList" },
        "stream": { "type": "boolean" },
        "min_litellm_version": { "type": "string", "maxLength": 32 },
        "max_litellm_version": { "type": "string", "maxLength": 32 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": { "type": "string", "minLength": 1, "maxLength": 96 },
        "options": { "type": "object", "default": {} }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "phase", "operations"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "description": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "phase": { "enum": ["request", "response", "stream", "error"] },
        "priority": { "type": "integer", "minimum": -100000, "maximum": 100000, "default": 0 },
        "required": { "type": "boolean", "default": false },
        "failure_mode": { "enum": ["reject", "passthrough"], "default": "reject" },
        "match": { "$ref": "#/$defs/match" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    }
  }
}
